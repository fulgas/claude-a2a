{
  "name": "claude-a2a",
  "version": "0.1.0",
  "license": "MIT OR Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild bridge/a2a.mjs --bundle --platform=node --format=esm --target=node20 --minify --outfile=dist/a2a.mjs --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\"",
    "docs": "node docs-site/zola.mjs && node docs-site/sync.mjs && docs-site/.zola/zola --root docs-site build",
    "docs:serve": "node docs-site/zola.mjs && node docs-site/sync.mjs && docs-site/.zola/zola --root docs-site serve --port 8000"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.3.0",
    "@bufbuild/protobuf": "^2.10.2",
    "@grpc/grpc-js": "^1.11.0",
    "express": "^5.1.0",
    "jose": "6.2.13"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@fontsource-variable/fraunces": "5.3.0",
    "esbuild": "0.25.12",
    "mermaid": "12.2.0"
  }
}
